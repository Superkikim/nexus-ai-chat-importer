{
    "compilerOptions": {
        "target": "ES2018",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "paths": {
            "obsidian": ["./src/obsidian-shim"]
        },
        "declaration": false,
        "resolveJsonModule": true,
        "moduleResolution": "bundler"
    },
    "include": ["src/**/*.ts"]
}
